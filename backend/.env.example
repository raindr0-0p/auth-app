# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/auth_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Settings
SECRET_KEY=your-super-secret-key-change-in-production-32-chars-min
ENVIRONMENT=development

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Session Settings
SESSION_EXPIRE_MINUTES=60

# Token Expiration Settings
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# Rate Limiting Settings
LOGIN_RATE_LIMIT_PER_MINUTE=5
SIGNUP_RATE_LIMIT_PER_MINUTE=3
FORGOT_PASSWORD_RATE_LIMIT_PER_HOUR=3
RESEND_VERIFICATION_RATE_LIMIT_PER_HOUR=3